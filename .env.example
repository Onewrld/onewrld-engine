# Copy this file to `.env` and fill in values. `.env` is never committed to git.
# Lines starting with # are comments.

# MODE controls whether the system is allowed to touch the outside world.
#   dry_run = (default) do everything EXCEPT post, spend, or send. Logs what it WOULD do.
#   staging = real calls only to test/sandbox targets.
#   live    = real posting/spending. Only switch to this when a phase says so.
MODE=dry_run

# Where errors and the Monday memo go. Not a secret.
ALERT_EMAIL=you@example.com

# Supabase database connection string. This IS a secret. See RUNBOOK section 6.
# Use the "Session pooler" string from Supabase's Connect button, with your password filled in.
DATABASE_URL=

# Postgres schema (named folder of tables) this system uses. Leave as is.
DB_SCHEMA=engine

# Email alerts (RUNBOOK section 9). Sends FROM this Gmail account TO ALERT_EMAIL.
# SMTP_APP_PASSWORD is a Google "app password" (16 letters), NOT your normal password. Secret.
SMTP_USER=
SMTP_APP_PASSWORD=
